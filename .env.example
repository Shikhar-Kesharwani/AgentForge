# ===================================================================
# AGENTFORGE ENVIRONMENT CONFIGURATION
# ===================================================================

# --- REQUIRED FOR ALL MODELS ---
GEMINI_API_KEY=your_gemini_api_key_here
API_KEY=default-dev-key

# --- MODEL 1: STANDALONE LOCAL DOCKER STACK ---
# Leave DATABASE_URL and PINECONE_API_KEY commented out or blank.
# The system will automatically use local SQLite & local ChromaDB.
PORT=8000

# --- MODEL 2: SEPARATE CLOUD DEPLOYMENT (ENTERPRISE) ---
# Uncomment and fill these to dynamically connect to managed cloud services:
# DATABASE_URL=postgresql://user:password@ep-cool-db-12345.us-east-1.aws.neon.tech/agentforge?sslmode=require
# PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_INDEX_NAME=agentforge
