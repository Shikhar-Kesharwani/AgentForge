{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/static/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, HEAD, POST, OPTIONS, PUT, DELETE" }
      ]
    }
  ]
}
